# Kopier denne filen til .env.local og fyll inn verdier.
# .env.local er git-ignorert og skal aldri committes.

# --- Fiken ---
# Personlig API-nøkkel (for utvikling / din egen konto):
# Fiken -> Rediger konto -> Sikkerhet -> Personlige API-nøkler
FIKEN_API_TOKEN=

# Fiken OAuth2-klient (for at andre brukere skal koble til sin egen Fiken-konto).
# Får du ved å be Fiken om API-tilgang for en applikasjon (support@fiken.no).
FIKEN_CLIENT_ID=
FIKEN_CLIENT_SECRET=
# Må matche redirect-URI-en som er registrert hos Fiken.
FIKEN_REDIRECT_URI=http://localhost:3000/api/fiken/oauth/callback

# --- Supabase ---
# Project Settings -> API i Supabase-dashbordet
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role-nøkkelen brukes kun server-side (cron, admin). ALDRI i klienten.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (kontrakt-uttrekk) ---
ANTHROPIC_API_KEY=

# --- E-post (varsler) ---
RESEND_API_KEY=
REMINDER_FROM_EMAIL=varsel@notisen.no

# --- Cron ---
# Tilfeldig streng. Vercel Cron sender denne som Authorization-header.
CRON_SECRET=
