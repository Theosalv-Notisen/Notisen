# Kopier denne filen til .env.local og fyll inn verdier.
# .env.local er git-ignorert og skal aldri committes.

# --- Fiken ---
# OAuth2-klient for "Notisen"-appen i Fiken. Fiken krever OAuth for
# integrasjoner som brukes av andre: personlige API-nøkler er kun for egen bruk.
FIKEN_CLIENT_ID=
FIKEN_CLIENT_SECRET=
# Må matche redirect-URI-en som er registrert på appen i Fiken.
FIKEN_REDIRECT_URI=http://localhost:3000/api/fiken/oauth/callback

# --- Supabase ---
# Project Settings -> API i Supabase-dashbordet
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role-nøkkelen brukes kun server-side (cron, admin). ALDRI i klienten.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (kontrakt-uttrekk) ---
ANTHROPIC_API_KEY=

# --- E-post (varsler) ---
# API-nøkkel fra Resend. MÅ fylles inn for at varsel-cronen skal sende e-post.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=varsel@notisen.no

# --- App ---
# Basis-URL for appen, brukt til lenker i e-post.
# Prod: https://notisen.no  ·  Dev: http://localhost:3000 (default hvis tom)
APP_URL=

# --- Cron ---
# Tilfeldig streng. Vercel Cron sender denne som Authorization-header.
CRON_SECRET=

# --- Token-kryptering ---
# Nøkkel for kryptering av Fiken OAuth-tokens (access/refresh) før lagring i
# Supabase. Nøyaktig 32 bytes, base64-kodet. Generer med:
#   openssl rand -base64 32
# ALDRI prefiks med NEXT_PUBLIC_ – nøkkelen skal aldri ut i klienten.
# Mister du denne må alle koble til Fiken på nytt. Ta backup av verdien.
TOKEN_ENC_KEY=

# --- Rate limiting (valgfritt) ---
# Upstash Redis for rate limiting på innlogging / registrering / passordreset.
# Mangler begge → rate limiting er deaktivert (appen virker uansett).
# Enklest: Vercel → Integrations → "Upstash" → koble til (setter disse selv).
# Vercel-integrasjonen navngir variablene ut fra prefikset ditt. Koden leser
# begge navnevariantene under. Bruk skrive-tokenet (_REST_API_TOKEN), ikke
# _READ_ONLY_TOKEN.
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
# (eldre standardnavn, brukes som fallback hvis de over mangler)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Feilovervåking (valgfritt, backend-only) ---
# Sentry-DSN. Mangler den → ingen feilovervåking (appen virker uansett).
# Opprett gratis konto på sentry.io, lag et Next.js-prosjekt, kopier DSN-en.
SENTRY_DSN=
# For lesbare (av-minifiserte) stacktraces: last opp source maps ved build.
# Trengs kun i Vercel. Lag et Internal Integration-token i Sentry med
# "Releases: admin". Uten disse fanges feil fortsatt, men stacktrace er minifisert.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
